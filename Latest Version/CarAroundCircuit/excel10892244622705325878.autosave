import java.io.FileOutputStream;

void saveSpeedsToExcel(double[][][] radius, double laptime, double geneticBest, double [] tyres, double speeds, double [] [] [] telemetry) {
  try {
    XSSFWorkbook workbook = new XSSFWorkbook();
    XSSFSheet sheet = workbook.createSheet("Telemetry");

    // Header
    Row header = sheet.createRow(0);
    header.createCell(0).setCellValue("Point");
    header.createCell(1).setCellValue("Soft (m/s)");
    header.createCell(2).setCellValue("Medium (m/s)");
    header.createCell(3).setCellValue("Hard (m/s)");
    header.createCell(4).setCellValue("Optimal Lap Speed (m/s)");

    // j = 2 is optimal lap
    int optimalJ = 2;

    // Data
    for (int i = 0; i < steps; i++) {
      double r = radius[optimalJ][i][2];

      double soft = Math.sqrt(tyres[0] * 9.81 * r);
      double medium = Math.sqrt(tyres[1] * 9.81 * r);
      double hard = Math.sqrt(tyres[2] * 9.81 * r);

      // assumes telemetry[j][i][2] is speed
      double optimalSpeed = telemetry[optimalJ][i][2];

      Row row = sheet.createRow(i + 1);
      row.createCell(0).setCellValue(i);
      row.createCell(1).setCellValue(soft);
      row.createCell(2).setCellValue(medium);
      row.createCell(3).setCellValue(hard);
      row.createCell(4).setCellValue(optimalSpeed);
    }

    // === Create scatter chart ===
    XSSFDrawing drawing = sheet.createDrawingPatriarch();
    XSSFClientAnchor anchor = drawing.createAnchor(0, 0, 0, 0, 6, 1, 16, 20);
    XSSFChart chart = drawing.createChart(anchor);
    chart.setTitleText("Speed Comparison by Point");
    chart.setTitleOverlay(false);

    XDDFChartLegend legend = chart.getOrAddLegend();
    legend.setPosition(org.apache.poi.xddf.usermodel.chart.LegendPosition.RIGHT);

    XDDFCategoryAxis bottomAxis =
      chart.createCategoryAxis(org.apache.poi.xddf.usermodel.chart.AxisPosition.BOTTOM);
    bottomAxis.setTitle("Point");

    XDDFValueAxis leftAxis =
      chart.createValueAxis(org.apache.poi.xddf.usermodel.chart.AxisPosition.LEFT);
    leftAxis.setTitle("Speed (m/s)");

    XDDFDataSource<Double> points =
      XDDFDataSourcesFactory.fromNumericCellRange(sheet, new CellRangeAddress(1, steps, 0, 0));
    XDDFNumericalDataSource<Double> softData =
      XDDFDataSourcesFactory.fromNumericCellRange(sheet, new CellRangeAddress(1, steps, 1, 1));
    XDDFNumericalDataSource<Double> mediumData =
      XDDFDataSourcesFactory.fromNumericCellRange(sheet, new CellRangeAddress(1, steps, 2, 2));
    XDDFNumericalDataSource<Double> hardData =
      XDDFDataSourcesFactory.fromNumericCellRange(sheet, new CellRangeAddress(1, steps, 3, 3));
    XDDFNumericalDataSource<Double> optimalSpeedData =
      XDDFDataSourcesFactory.fromNumericCellRange(sheet, new CellRangeAddress(1, steps, 4, 4));

    XDDFScatterChartData data =
      (XDDFScatterChartData) chart.createData(ChartTypes.SCATTER, bottomAxis, leftAxis);
    data.setStyle(ScatterStyle.LINE);

    data.addSeries(points, softData).setTitle("Soft Limit", null);
    data.addSeries(points, mediumData).setTitle("Medium Limit", null);
    data.addSeries(points, hardData).setTitle("Hard Limit", null);
    data.addSeries(points, optimalSpeedData).setTitle("Optimal Lap Speed", null);

    chart.plot(data);

    // Autosize columns
    for (int i = 0; i < 5; i++) sheet.autoSizeColumn(i);

    // Save Excel file
    FileOutputStream fileOut = new FileOutputStream(sketchPath("data.xlsx"));
    workbook.write(fileOut);
    fileOut.close();
    workbook.close();

    println("Excel file with optimal lap speed + scatter chart created: data.xlsx");

  } catch (Exception e) {
    e.printStackTrace();
  }
}
