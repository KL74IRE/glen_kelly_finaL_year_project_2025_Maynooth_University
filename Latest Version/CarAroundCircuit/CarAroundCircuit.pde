/*
Main Start-Up Method,
Controls which tracks are initialised,
Controls which information can be displayed
Allows entering of specialised editing mode for tracks
*/

void setup() {                                                                    //Main Method, no return
  size(1920, 980);                                                                  //Size of Window
  background(255);                                                                  //White Background
  int steps = 100;                                                                   //Number of steps that will be take around the track
  boolean excel = false;                                                            //If speed Data should be exported to excel
  boolean showWaypoints = false;                                                    //If original Waypoints should be shown
  boolean showPoints = false;                                                       //If points that are generated by spline should be shown
  boolean showSpeeds = false;                                                        //If speeds at generated points should be displayed
  boolean telemetryS = false;
  boolean edit = false;                                                             //If editing mode should be entered
  boolean brands = false;                                                           //If Brands Hatch should be initiated
  boolean bahrain = false;                                                          //If Bahrain should be initiated
  boolean circle = true;                                                           //If a basic circle should be initiated
  boolean showTPs = true;
  
  if(edit){editingMode();}                                                          //If enabled enter editing mode
  if(brands){brandsHatch(steps,excel,showWaypoints,showPoints,showSpeeds,telemetryS, showTPs);}         //If enabled initiate Brands Hatch
  if(circle){basicCircle(steps,excel,showWaypoints,showPoints,showSpeeds,telemetryS, showTPs);}         //If enabled initiate a basic circle
  if(bahrain){bahrain(steps,excel,showWaypoints,showPoints,showSpeeds, telemetryS, showTPs);}            //If enabled initiate Bahrain
}
